# Required by the web application
DATABASE_URL=postgresql://user:password@localhost:5432/tiktok_analytics
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_value

# Required only for the local browser-sync workflow
BOT_SECRET=replace_with_a_different_long_random_value
BOT_TARGET_HANDLE=@demo_account
BOT_TARGET_PROFILE=Default

# Optional AI analysis
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-3.5-sonnet

# Optional TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
